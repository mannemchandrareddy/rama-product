# Server Environment Variables Template
PORT=8000
APP_ENV=production
APP_NAME=Local Commerce Intelligence Platform
APP_VERSION=1.0.0

# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rama_product?retryWrites=true&w=majority

# Supabase Auth
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# CORS Origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:3000,https://<your-app>.vercel.app
